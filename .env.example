# Kopiraj u .env i postavi vrijednosti prije pokretanja docker compose
ADMIN_EMAIL=admin@erv.hr
ADMIN_PASSWORD=promijeni-me
DB_PASSWORD=promijeni-me

# Slanje e-poste. Ostavi MAIL_HOST prazan i obavijesti se samo zapisuju u dnevnik.
# Lokalni SMTP za probu (Mailpit):      MAIL_HOST=mailpit  MAIL_PORT=1025  MAIL_AUTH=false  MAIL_STARTTLS=false
# Gmail s aplikacijskom lozinkom:       MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=evidencija@erv.hr
